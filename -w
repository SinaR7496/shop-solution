import {markup,mountModule} from '/modules/admin-identity/page.js';
const $=id=>document.getElementById(id);
const config=window.ERP_CONFIG || {apiBase:'http://localhost:8000'};
let token=null, email='', generation=0;
function status(text,error=false) {
  $('login-status').textContent=text; $('login-status').className=error?'error':'';
  $('login-status').setAttribute('role',error?'alert':'status');
}
function clearSession(text='') {
  generation++; token=null; email=''; $('module-screen').replaceChildren(); $('login-form').reset();
  render(); status(text,Boolean(text)); $('email').focus();
}
async function api(path,{method='GET',body}={}) {
  const requestGeneration=generation;
  let response;
  // Keep Bearer calls independent of cookie CORS; cookie session/login/logout need credentials.
  try { response=await fetch(config.apiBase+path,{method,credentials:(!token || path==='/auth/login' || path==='/auth/logout')?'include':'omit',headers:{'X-ERP-CSRF':'1',...(body?{'Content-Type':'application/json'}:{}),...(token?{Authorization:`Bearer ${token}`}:{})},...(body?{body:JSON.stringify(body)}:{}),signal:AbortSignal.timeout(10000)}); }
  catch { throw new Error('Dienst nicht erreichbar. Bitte erneut versuchen.'); }
  const data=await response.json().catch(()=>({}));
  if(response.ok) return data;
  const d=data.detail;
  if(response.status===401) {
    if(path==='/auth/login') throw new Error('E-Mail oder Passwort falsch, oder Konto inaktiv.');
    if(requestGeneration===generation) clearSession('Sitzung abgelaufen. Bitte erneut anmelden.');
    throw new Error('Sitzung abgelaufen. Bitte erneut anmelden.');
  }
  if(response.status===403 && d==='Cannot assign a role to yourself') throw new Error('Du kannst dir selbst keine Rolle zuweisen.');
  if(response.status===403 && typeof d==='string' && d.startsWith('Missing permission ')) throw new Error(`Keine Berechtigung: ${d.slice(19)}.`);
  if(response.status===404) throw new Error('Benutzer nicht gefunden.');
  if(response.status===422) throw new Error('Eingabe vom Server abgelehnt. Bitte Felder prüfen.');
  if(response.status>=500) throw new Error('Dienst nicht erreichbar. Bitte erneut versuchen.');
  throw new Error('Anfrage fehlgeschlagen. Bitte erneut versuchen.');
}
function render() {
  const signed=Boolean(email), neighbour=location.hash==='#search';
  $('login-screen').hidden=signed; $('session').hidden=!signed; $('navigation').hidden=!signed;
  $('signed-in').textContent=signed?`Angemeldet als ${email}`:'';
  $('module-screen').hidden=!signed || neighbour; $('neighbour-screen').hidden=!signed || !neighbour;
  $('nav-admin').removeAttribute('aria-current'); $('nav-search').removeAttribute('aria-current');
  $(neighbour?'nav-search':'nav-admin').setAttribute('aria-current','page');
  if(signed && !$('module-screen').hasChildNodes()) {
    $('module-screen').innerHTML=markup; const mounted=generation;
    mountModule({api,isCurrent:()=>mounted===generation && Boolean(email)});
  }
  if(signed) (neighbour?$('neighbour-screen'):$('module-screen')).querySelector('h1').focus();
}
$('login-form').onsubmit=async event=>{
  event.preventDefault(); const enteredEmail=$('email').value.trim(),password=$('password').value;
  if(!enteredEmail || !password) {status('Bitte E-Mail und Passwort eingeben.',true);return;}
  if(!$('email').validity.valid) {status('Bitte eine gültige E-Mail-Adresse eingeben.',true);return;}
  $('login-button').disabled=true; status('Anmeldung läuft …');
  const started=generation;
  try { const result=await api('/auth/login',{method:'POST',body:{email:enteredEmail,password}}); if(started!==generation) return; token=result.access_token; email=enteredEmail; generation++; $('password').value=''; status(''); render(); if(location.hash!=='#search') $('user-id').focus(); }
  catch(e) { if(started===generation) { $('password').value=''; status(e.message,true); } }
  finally { $('login-button').disabled=false; }
};
$('logout').onclick=async()=>{
  try { await api('/auth/logout',{method:'POST'}); clearSession(); }
  catch(e) { status(e.message,true); window.alert(e.message); }
}; window.addEventListener('hashchange',render);
if(config.neighbourUrl && /^https?:\/\//.test(config.neighbourUrl)) { $('external-neighbour').hidden=false; $('neighbour-link').href=config.neighbourUrl; $('nav-marketing').href=config.neighbourUrl; }
render();

// Recover the shared cookie session after returning from another module.
const restoring=generation;
fetch(config.apiBase+'/auth/session',{credentials:'include'})
  .then(async response=>{ if(!response.ok) return; const user=await response.json();
    if(generation!==restoring || email) return;
    email=user.email; generation++; render();
  }).catch(()=>{});
